	quest.798D00CFC7A33E4C.quest_desc: [
		"&3Pot&r will allow you to cook a few complex dishes on the &3Firepit&r."
		""
		"Click on the Firepit to set it up."
	]
	quest.798D00CFC7A33E4C.title: "Pot"
	quest.7A1F9767F054AC56.quest_desc: [
		"For progression you need a better anvil. For better anvil you need double ingots."
		""
		"Heat ingots up to \"Can Weld\" state, then put them into the anvil and shift-right-click with a hammer."
		"You also need flux in the anvil for welding."
	]
	quest.7A95E44400530D7B.quest_desc: [
		"Using collected fruits, berries and vegetables you can make alchogol."
		""
		"Go check &6Collections: Food&r chapter for recipes."
	]
